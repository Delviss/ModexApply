{
  "name": "@modex/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain contracts: money, error envelope, pagination, roles, verification, provenance and requirement rules.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@modex/config": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
