{
  "name": "@modex/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Red Velvet design system \u2014 tokens, primitives, re-themed 21st.dev blocks and the Modex signature components.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./styles.css": "./src/styles/components.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "pnpm build:tokens && tsc -b",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "pnpm build:tokens && vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@modex/contracts": "workspace:*",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@modex/config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
