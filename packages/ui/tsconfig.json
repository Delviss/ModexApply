{
  "extends": "../config/tsconfig.react.json",
  "compilerOptions": {
    "outDir": "dist",
    // Inside `dist`, deliberately. With the build info outside the output
    // directory, `rm -rf dist` leaves `tsc -b` believing it is up to date and
    // it emits nothing — which is how a fresh clone ends up with a package
    // that "built" and has no files in it.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "stories"
  ],
  "references": [
    {
      "path": "../contracts"
    }
  ]
}
