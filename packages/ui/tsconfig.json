{
  "extends": "../config/tsconfig.react.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "stories"
  ],
  "references": [
    {
      "path": "../contracts"
    }
  ]
}
