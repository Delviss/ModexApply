# Copy to .env for local development. Never commit a real .env.
# `make dev` fills these in for the local docker services.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://modex:modex@localhost:5432/modex?schema=public

# 32+ characters. In every deployed environment this comes from the managed
# secret store and is rotated; the value below is for local development only.
JWT_SIGNING_KEY=local-development-only-signing-key-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=modex-documents
S3_ACCESS_KEY_ID=modex
S3_SECRET_ACCESS_KEY=modex-local-secret
SIGNED_URL_TTL_SECONDS=300

PUBLIC_WEB_ORIGIN=http://localhost:3000

# Server-side only, and deliberately not NEXT_PUBLIC_: Next inlines
# NEXT_PUBLIC_* at build time, which would tie a built artefact to one
# environment and break promoting the same image from staging to production.
API_ORIGIN=http://localhost:3001

# Comma-separated. `flag@25` enables a flag for a stable 25% of subjects.
FEATURE_FLAGS=catalogue.bulk_import,institution.self_serve_onboarding

# Required to install 21st.dev blocks through the shadcn registry. Lives in the
# managed secret store and is never committed.
# API_KEY_21ST=
