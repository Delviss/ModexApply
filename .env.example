# Copy to .env for local development. Never commit a real .env.
# `make dev` fills these in for the local docker services.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://modex:modex@localhost:5432/modex?schema=public

# 32+ characters. In every deployed environment this comes from the managed
# secret store and is rotated; the value below is for local development only.
JWT_SIGNING_KEY=local-development-only-signing-key-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=modex-documents
S3_ACCESS_KEY_ID=modex
S3_SECRET_ACCESS_KEY=modex-local-secret
SIGNED_URL_TTL_SECONDS=300

PUBLIC_WEB_ORIGIN=http://localhost:3000

# Malware scanning for the document vault (Phase 2 §2).
#
# `none` is the fail-closed default: with no scanner, every uploaded version
# stays `pending` and nothing reaches a university connector. `make dev` starts
# clamav, so local development uses the real thing.
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Per-country document retention, `GB:2555,NG:1825`, with `default:` for the
# rest. Launch-market data rules differ and the region is still an open
# decision (issue #1 §7), so this is configuration rather than a constant.
DOCUMENT_RETENTION_DAYS=default:2555

# Which SearchIndex adapter to use. `postgres` today; `opensearch` when that
# adapter lands against the same contract tests.
SEARCH_INDEX_DRIVER=postgres
# OPENSEARCH_URL=

# Server-side only, and deliberately not NEXT_PUBLIC_: Next inlines
# NEXT_PUBLIC_* at build time, which would tie a built artefact to one
# environment and break promoting the same image from staging to production.
API_ORIGIN=http://localhost:3001

# Comma-separated. `flag@25` enables a flag for a stable 25% of subjects.
FEATURE_FLAGS=catalogue.bulk_import,institution.self_serve_onboarding

# Required to install 21st.dev blocks through the shadcn registry. Lives in the
# managed secret store and is never committed.
# API_KEY_21ST=

# ---------------------------------------------------------------------------
# Connector credentials (Phase 4)
# ---------------------------------------------------------------------------
# A `connector_configs` row stores only the *name* of a credential, never the
# credential — the table is read by ops tooling and lands in backups, and a
# partner's API key in a column is a partner's API key in a backup.
#
# `EnvSecretResolver` maps `credentialRef: "oxford-api"` to the variable below,
# uppercased with non-alphanumerics folded to underscores. A managed secret
# manager implements the same `SecretResolver` interface without touching an
# adapter.
# MODEX_SECRET_OXFORD_API=
# MODEX_SECRET_OXFORD_WEBHOOK=
#
# Direct submission is off until a partner is switched on explicitly:
# FEATURE_FLAGS=...,connector.direct_application
