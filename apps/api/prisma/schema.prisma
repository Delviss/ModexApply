// Modex Apply — platform core and Phase 1 catalogue.
//
// Two structural rules run through this schema:
//
//  1. **Append-only audit.** `AuditEvent` has no update or delete path. The
//     application never issues one, and the migration additionally revokes the
//     grants and installs a trigger, so the guarantee does not depend on
//     application discipline. See `prisma/migrations/*_audit_append_only`.
//
//  2. **Effective dating.** `Program` is versioned: editing a live programme
//     writes a new row and closes the previous one. An application snapshot
//     taken last week therefore still resolves to exactly what the student was
//     shown. `programKey` is stable across versions; `id` is not.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  student
  guide
  university_admin
  university_staff
  trust_agent
  ops
  finance
  superadmin
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  passwordHash    String?
  /// Institution this user belongs to. Null for students, guides and Modex
  /// staff. Every institution-scoped query is filtered on this, server-side.
  organisationId  String?
  displayName     String
  status          UserStatus @default(active)
  mfaEnrolledAt   DateTime?
  mfaSecretRef    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organisation   Institution?    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  roles          UserRoleGrant[]
  sessions       Session[]
  consents       ConsentGrant[]
  studentProfile StudentProfile?
  documents      Document[]
  guideProfile   StudentGuide?
  conversations  Conversation[]
  guideSessions  GuideSession[]
  applications   Application[]

  @@index([organisationId])
  @@map("users")
}

enum UserStatus {
  active
  suspended
  closed
}

model UserRoleGrant {
  id        String    @id @default(uuid())
  userId    String
  role      Role
  /// Role grants are themselves scoped: a `university_staff` grant is only
  /// meaningful for one institution.
  scopeId   String?
  grantedBy String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeId])
  @@index([userId])
  @@map("user_role_grants")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  /// Hash of the refresh token. The token itself is never stored.
  refreshTokenHash String    @unique
  /// Rotation chain: a reused parent is treated as theft and revokes the family.
  parentId         String?
  familyId         String
  userAgent        String?
  ipHash           String?
  mfaSatisfied     Boolean   @default(false)
  /// Last time this session cleared a step-up challenge (Phase 6 §2). Freshness
  /// is compared against a clock, never treated as a flag — see
  /// `isStepUpFresh`. Null means the session has never stepped up.
  stepUpAt         DateTime?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

enum ConsentScope {
  guide_access
  document_share
  university_submission
  marketing_contact
  support_access
}

model ConsentGrant {
  id            String       @id @default(uuid())
  userId        String
  scope         ConsentScope
  /// What the consent is scoped to — an institution, a guide, a document.
  subjectId     String?
  grantedAt     DateTime     @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  /// Version of the wording the user actually agreed to.
  noticeVersion String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@map("consent_grants")
}

// ---------------------------------------------------------------------------
// Audit — append only
// ---------------------------------------------------------------------------

enum ActorType {
  user
  system
  connector
}

model AuditEvent {
  id            String    @id @default(uuid())
  actorId       String?
  actorType     ActorType
  action        String
  objectType    String
  objectId      String
  timestamp     DateTime  @default(now())
  authContext   Json
  correlationId String
  /// Hash over the previous event's integrityRef plus this event's payload, so
  /// a deletion at the storage layer is detectable even though the application
  /// has no delete path.
  integrityRef  String
  metadata      Json      @default("{}")

  @@index([objectType, objectId])
  @@index([actorId])
  @@index([correlationId])
  @@index([timestamp])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  key            String           @id
  /// Route + actor, so one client's key cannot replay another's response.
  scope          String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  state          IdempotencyState @default(in_flight)
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}

enum IdempotencyState {
  in_flight
  completed
  failed
}

// ---------------------------------------------------------------------------
// Institutions & partnership (Phase 1 §1)
// ---------------------------------------------------------------------------

enum VerificationState {
  unverified
  pending
  verified
  expired
  revoked
}

enum VerificationStage {
  legal_entity_check
  official_domain_confirmation
  partner_contact_confirmation
  signed_contract
  active
}

model Institution {
  id                String             @id @default(uuid())
  legalName         String
  displayName       String
  /// Official domains. Domain confirmation binds the institution to one of these.
  domains           String[]
  country           String             @db.Char(2)
  verificationState VerificationState  @default(unverified)
  verificationStage VerificationStage?
  brandColor        String?
  websiteUrl        String?
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  partnerships         InstitutionPartnership[]
  campuses             Campus[]
  contacts             InstitutionContact[]
  programs             Program[]
  domainChallenges     DomainChallenge[]
  evidence             VerificationEvidence[]
  staff                User[]
  syncRuns             SyncRun[]
  imports              CatalogueImport[]
  eligibilityOverrides EligibilityOverride[]
  guides               StudentGuide[]
  questions            GuideQuestion[]
  applications         Application[]
  connectors           ConnectorConfig[]
  offers               Offer[]

  @@index([country])
  @@index([verificationState])
  @@map("institutions")
}

enum PartnershipStatus {
  prospect
  in_onboarding
  contract_pending
  active
  suspended
  revoked
  expired
}

enum PartnershipScope {
  catalogue_publish
  direct_application
  brand_use
  guide_programme
  offer_publication
  scholarship_publication
}

model InstitutionPartnership {
  id            String             @id @default(uuid())
  institutionId String
  status        PartnershipStatus  @default(prospect)
  /// Pointer to the executed contract in secure storage — never the contract.
  contractRef   String?
  startDate     DateTime?
  endDate       DateTime?
  scopes        PartnershipScope[]
  markets       String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
  @@map("institution_partnerships")
}

model Campus {
  id            String  @id @default(uuid())
  institutionId String
  name          String
  addressLine1  String?
  city          String
  country       String  @db.Char(2)
  latitude      Float?
  longitude     Float?

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs    Program[]
  guides      StudentGuide[]

  @@index([institutionId])
  @@map("campuses")
}

enum ContactRole {
  authorised_signatory
  admissions
  international_office
  technical
  finance
}

model InstitutionContact {
  id                    String      @id @default(uuid())
  institutionId         String
  fullName              String
  email                 String
  role                  ContactRole
  isAuthorisedSignatory Boolean     @default(false)
  verifiedAt            DateTime?
  /// Single-use token hash for the on-domain confirmation email.
  challengeTokenHash    String?
  challengeExpiresAt    DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, email])
  @@map("institution_contacts")
}

enum ChallengeMethod {
  dns_txt
  email_on_domain
}

model DomainChallenge {
  id            String          @id @default(uuid())
  institutionId String
  domain        String
  method        ChallengeMethod
  /// The value the institution must publish. Never written to a log.
  token         String
  issuedAt      DateTime        @default(now())
  expiresAt     DateTime
  confirmedAt   DateTime?
  attempts      Int             @default(0)
  lastError     String?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, domain])
  @@map("domain_challenges")
}

/// Verification evidence is retained separately from the public record and is
/// never exposed publicly (Phase 1 §2). Nothing in the public API selects this
/// table.
model VerificationEvidence {
  id            String            @id @default(uuid())
  institutionId String
  stage         VerificationStage
  /// Object-storage key. The document itself never enters the database.
  documentRef   String?
  /// Short, internal description of what was checked.
  summary       String
  collectedBy   String
  collectedAt   DateTime          @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, stage])
  @@map("verification_evidence")
}

// ---------------------------------------------------------------------------
// Catalogue (Phase 1 §3)
// ---------------------------------------------------------------------------

enum SyncState {
  synced
  stale
  pending_review
  manual
  failed
}

enum ProgramLevel {
  foundation
  undergraduate
  postgraduate_taught
  postgraduate_research
  doctorate
  pathway
  short_course
}

enum ProgramStatus {
  draft
  in_review
  published
  unpublished
  archived
}

enum StudyMode {
  full_time
  part_time
  distance
  hybrid
}

model Program {
  id             String        @id @default(uuid())
  /// Stable across every effective-dated version of the same programme.
  programKey     String
  institutionId  String
  campusId       String?
  name           String
  level          ProgramLevel
  field          String
  durationMonths Int
  studyMode      StudyMode     @default(full_time)
  description    String?
  status         ProgramStatus @default(draft)
  version        Int           @default(1)
  effectiveFrom  DateTime      @default(now())
  /// Null means "current". A closed version is immutable history.
  effectiveTo    DateTime?

  // Provenance (Phase 1 §3) — on every catalogue record, without exception.
  sourceUpdatedAt DateTime?
  verifiedAt      DateTime?
  expiresAt       DateTime?
  syncState       SyncState @default(pending_review)
  sourceRef       String?
  reviewedBy      String?
  /// Fields whose freshness SLA has lapsed. Blocking fields hide the record.
  staleFields     String[]

  createdAt DateTime @default(now())

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus       Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  requirements Requirement[]
  fees         ProgramFees[]

  @@unique([programKey, version])
  @@index([institutionId, status])
  @@index([programKey, effectiveTo])
  @@index([status, syncState])
  @@map("programs")
}

enum IntakeStatus {
  scheduled
  open
  closing_soon
  closed
  cancelled
}

model Intake {
  id                  String       @id @default(uuid())
  /// Intakes hang off the stable key, not off one programme version — an edit
  /// to the description must not orphan the deadlines.
  programKey          String
  startDate           DateTime
  applicationDeadline DateTime
  status              IntakeStatus @default(scheduled)
  capacity            Int?

  sourceUpdatedAt DateTime?
  verifiedAt      DateTime?
  expiresAt       DateTime?
  syncState       SyncState @default(pending_review)
  sourceRef       String?
  reviewedBy      String?
  staleFields     String[]

  requirements Requirement[]
  applications Application[]

  @@index([programKey, applicationDeadline])
  @@index([status])
  @@map("intakes")
}

enum RuleType {
  academic_qualification
  gpa_minimum
  english_language
  work_experience
  portfolio
  interview
  age_minimum
  nationality_restriction
  document_required
}

model Requirement {
  id           String   @id @default(uuid())
  programId    String
  intakeId     String?
  ruleType     RuleType
  /// Machine-readable rule. Validated against the contract's discriminated
  /// union before write — an unparseable rule is rejected, never stored.
  ruleJson     Json
  /// The sentence a student actually reads. Mandatory: a rule with no summary
  /// is a rule nobody can contest.
  humanSummary String
  sourceRef    String
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  program   Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  intake    Intake?               @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  overrides EligibilityOverride[]

  @@index([programId])
  @@map("requirements")
}

/// Money is integer minor units + ISO 4217 (Phase 0 §3.5). There is no decimal
/// column here on purpose.
model ProgramFees {
  id                     String  @id @default(uuid())
  programId              String
  intakeId               String?
  tuitionMinor           Int
  tuitionCurrency        String  @db.Char(3)
  applicationFeeMinor    Int?
  applicationFeeCurrency String? @db.Char(3)
  depositMinor           Int?
  depositCurrency        String? @db.Char(3)

  sourceUpdatedAt DateTime?
  verifiedAt      DateTime?
  expiresAt       DateTime?
  syncState       SyncState @default(pending_review)
  sourceRef       String?
  reviewedBy      String?
  staleFields     String[]

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_fees")
}

// ---------------------------------------------------------------------------
// Ingestion & freshness (Phase 1 §4)
// ---------------------------------------------------------------------------

enum SyncRunStatus {
  running
  succeeded
  failed
  partial
}

model SyncRun {
  id             String        @id @default(uuid())
  institutionId  String
  trigger        String
  status         SyncRunStatus @default(running)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  recordsSeen    Int           @default(0)
  recordsChanged Int           @default(0)
  recordsFailed  Int           @default(0)
  error          String?
  correlationId  String

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, startedAt])
  @@map("sync_runs")
}

enum ImportState {
  dry_run
  committed
  discarded
}

/// Bulk import via structured file, with a dry-run diff before commit
/// (Phase 1 §4). The diff is stored so the reviewer approves exactly what they
/// were shown.
model CatalogueImport {
  id            String      @id @default(uuid())
  institutionId String
  fileName      String
  /// Object-storage key for the uploaded file.
  fileRef       String
  state         ImportState @default(dry_run)
  diff          Json
  summary       Json
  uploadedBy    String
  uploadedAt    DateTime    @default(now())
  committedBy   String?
  committedAt   DateTime?
  correlationId String

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, state])
  @@map("catalogue_imports")
}

// ---------------------------------------------------------------------------
// Student experience (Phase 2 #4)
// ---------------------------------------------------------------------------

enum GradeScale {
  gpa_4
  gpa_5
  percentage
  uk_class
  ects_grade
}

enum AcademicLevel {
  high_school
  diploma
  bachelors
  masters
  doctorate
}

enum LanguageTestName {
  ielts
  toefl_ibt
  pte
  duolingo
  cambridge
  moi_waiver
}

/// The student's reusable profile (Phase 2 §1).
///
/// Deliberately a separate table from `User`. Identity carries credentials and
/// is never shared; a profile carries academic history and test scores and is
/// shared with a university under an explicit `document_share` /
/// `university_submission` consent. Putting them in one row would make the
/// distinction a matter of which columns a query happened to select.
model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique

  dateOfBirth        DateTime? @db.Date
  /// ISO 3166-1 alpha-2. Nationality restriction rules turn on this.
  nationality        String?   @db.Char(2)
  countryOfResidence String?   @db.Char(2)

  intendedLevel      ProgramLevel?
  intendedField      String?
  preferredCountries String[]
  /// Integer minor units + ISO 4217, like every other money column here.
  budgetPerYearMinor Int?
  budgetCurrency     String?       @db.Char(3)
  /// Target intake as `YYYY-MM`, which is how intakes are actually discussed.
  targetIntake       String?

  workExperienceMonths Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicRecords AcademicRecord[]
  languageTests   LanguageTest[]
  savedSearches   SavedSearch[]
  shortlists      Shortlist[]

  @@map("student_profiles")
}

model AcademicRecord {
  id        String @id @default(uuid())
  profileId String

  level           AcademicLevel
  institutionName String
  countryCode     String        @db.Char(2)
  fieldOfStudy    String
  gradeScale      GradeScale?
  /// Position on `gradeScale`. Meaningless without it, so the two move together.
  gradeValue      Float?
  startedAt       DateTime
  /// Null means in progress. An unfinished degree is not a missing one.
  completedAt     DateTime?

  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("academic_records")
}

model LanguageTest {
  id        String @id @default(uuid())
  profileId String

  test      LanguageTestName
  overall   Float
  /// Per-band scores keyed as the test publishes them. A 6.5 overall with a 5.0
  /// in writing usually still fails, so the bands are not optional detail.
  bands     Json             @default("{}")
  takenAt   DateTime
  expiresAt DateTime?

  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
  @@map("language_tests")
}

// ---------------------------------------------------------------------------
// Document vault (Phase 2 §2)
// ---------------------------------------------------------------------------

enum DocumentType {
  passport
  transcript
  degree_certificate
  language_test
  personal_statement
  reference_letter
  cv
  financial_evidence
  portfolio
  other
}

enum ScanState {
  pending
  clean
  quarantined
  failed
}

model Document {
  id          String       @id @default(uuid())
  ownerId     String
  type        DocumentType
  /// What the student called it. Never used as an object key.
  displayName String

  /// The version the vault shows. Prior versions stay readable — an application
  /// snapshot references an exact `DocumentVersion`, and that reference has to
  /// keep resolving after the student uploads a better scan.
  currentVersionId String? @unique

  expiryAt  DateTime?
  /// Soft delete. Retention rules decide when the object itself goes, and a
  /// hard delete would break snapshots that reference a version.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions DocumentVersion[] @relation("DocumentVersions")

  @@index([ownerId, type])
  @@index([expiryAt])
  @@map("documents")
}

/// **Versions are never overwritten.** There is no update path to `objectKey`;
/// replacing a file writes a new row with the next `version`.
model DocumentVersion {
  id         String @id @default(uuid())
  documentId String
  version    Int

  /// Opaque storage key. Carries no filename: a bucket listing must not reveal
  /// who applied where.
  objectKey   String
  /// SHA-256 of the bytes actually stored. Null until the upload settles.
  checksum    String?
  sizeBytes   Int?
  contentType String?

  scanState      ScanState @default(pending)
  scannedAt      DateTime?
  scanDetail     String?
  /// False until the checksum matches. A row whose bytes never landed must not
  /// be one scanner bug away from looking acceptable.
  uploadComplete Boolean   @default(false)

  createdAt DateTime @default(now())

  document Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([scanState])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Search, shortlist and compare (Phase 2 §3)
// ---------------------------------------------------------------------------

/// Denormalised search document, generated from the authoritative catalogue
/// tables (Phase 2 §3).
///
/// Rebuilt wholesale per `programKey`, never edited field by field: a partial
/// update is how an index drifts from its source, and this row is what the
/// public sees. `visible` is computed from `publicVisibility(syncState,
/// staleFields)` at build time, so a programme the freshness sweeper pulled
/// cannot be surfaced by a query that forgot to filter.
model ProgramSearchDocument {
  programKey String @id
  programId  String
  version    Int

  name        String
  description String?
  level       ProgramLevel
  discipline  String
  language    String       @default("English")

  institutionId       String
  institutionName     String
  institutionVerified Boolean @default(false)
  country             String  @db.Char(2)
  city                String?

  durationMonths      Int
  tuitionMinor        Int?
  tuitionCurrency     String? @db.Char(3)
  applicationFeeMinor Int?

  /// `YYYY-MM` for every open intake, so an intake facet is one array contains.
  intakes      String[]
  nextDeadline DateTime?

  scholarshipAvailable Boolean @default(false)
  discountAvailable    Boolean @default(false)
  /// Commercial placement. Never bypasses a hard eligibility rule; see
  /// `apps/api/src/search/ranking.ts`.
  sponsored            Boolean @default(false)

  visible     Boolean   @default(false)
  staleFields String[]
  syncState   SyncState @default(pending_review)

  /// Concatenation of the searchable text, maintained by the indexer so the
  /// trigram index has a single column to sit on.
  searchText String

  indexedAt DateTime @default(now())

  @@index([visible, level])
  @@index([visible, country])
  @@index([visible, institutionId])
  @@index([visible, tuitionMinor])
  @@index([visible, nextDeadline])
  @@map("program_search_documents")
}

model SavedSearch {
  id        String @id @default(uuid())
  profileId String
  name      String
  /// The parsed `ProgramSearchQuery`, stored as given so a saved search keeps
  /// meaning what it meant when a facet is added later.
  query     Json

  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("saved_searches")
}

model Shortlist {
  id        String @id @default(uuid())
  profileId String
  name      String @default("My shortlist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile StudentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   ShortlistItem[]

  @@index([profileId])
  @@map("shortlists")
}

model ShortlistItem {
  id          String  @id @default(uuid())
  shortlistId String
  /// The stable key, not a version id: a shortlist should survive the
  /// university editing the description.
  programKey  String
  note        String?

  addedAt DateTime @default(now())

  shortlist Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, programKey])
  @@index([shortlistId])
  @@map("shortlist_items")
}

// ---------------------------------------------------------------------------
// Eligibility overrides (Phase 2 §4)
// ---------------------------------------------------------------------------

/// A university partner's correction to a rule the engine reads (Phase 2 §4).
///
/// Written by the admin tooling in #8; Phase 2 only reads them. Every
/// application of one writes an audit event, because an override is the one
/// place a human changes what a student is told about their own eligibility.
model EligibilityOverride {
  id            String @id @default(uuid())
  requirementId String
  institutionId String

  /// Forced outcome for this requirement, whatever the rule evaluates to.
  outcome CheckOutcome
  /// Shown to the student in place of the engine's own reason. Mandatory: an
  /// override nobody can read is an override nobody can contest.
  reason  String

  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([institutionId])
  @@map("eligibility_overrides")
}

enum CheckOutcome {
  pass
  fail
  unknown
  missing_data
}

// ---------------------------------------------------------------------------
// Verified Student Guide network (Phase 3 #5)
// ---------------------------------------------------------------------------

/// Guide lifecycle. `restricted` and `suspended` are separate because one is
/// the automatic consequence of lapsed evidence — undone the moment the guide
/// reverifies — and the other is a trust decision that needs a human to undo.
enum GuideState {
  pending
  active
  restricted
  suspended
  revoked
}

enum GuideVerificationStage {
  identity_check
  current_student_evidence
  institution_confirmation
  active
}

enum GuideEvidenceType {
  university_domain_email
  student_id_document
  institution_roster
}

enum GuideTopic {
  accommodation
  cost_of_living
  campus_life
  coursework
  teaching_style
  part_time_work
  arrival_and_settling_in
  city_and_transport
  societies_and_sport
  faith_and_community
  family_and_partners
  visa_paperwork_experience
}

/// A verified current student (Phase 3 §1, FR-016).
///
/// The row exists only as a link to current-student evidence: `institutionId`
/// is required, and `evidenceExpiresAt` is a denormalised mirror of the live
/// `GuideVerification` so the reverification sweep is one indexed scan rather
/// than a join across every guide on the platform.
///
/// Nothing here is a contact detail. Email and phone live on `User`, which no
/// student-facing projection reads — see `toPublicGuideProfile` in the
/// contracts package.
model StudentGuide {
  id            String  @id @default(uuid())
  userId        String  @unique
  institutionId String
  campusId      String?
  /// Stable programme key, not a version id: a guide should survive the
  /// university editing the programme description.
  programKey    String?

  level       ProgramLevel?
  yearOfStudy Int?
  languages   String[]
  homeCountry String?       @db.Char(2)
  topics      GuideTopic[]
  bio         String?

  state GuideState             @default(pending)
  stage GuideVerificationStage @default(identity_check)

  verifiedAt        DateTime?
  /// Mirror of the live evidence expiry. The sweep reads this column.
  evidenceExpiresAt DateTime?
  /// Set when the 30-day warning goes out, so the hourly sweep warns once.
  expiryNotifiedAt  DateTime?
  restrictedAt      DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  /// Tie-break only (Phase 3 §2). It never substitutes for verification.
  trustScore         Int     @default(50)
  /// True only where the university granted the staff role in its partnership
  /// scope. A guide is never presented as university staff by default.
  universityEndorsed Boolean @default(false)

  responseTimeHours Float?
  lastSeenAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus          Campus?                 @relation(fields: [campusId], references: [id], onDelete: SetNull)
  verifications   GuideVerification[]
  identityChanges GuideIdentityChange[]
  availability    GuideAvailabilitySlot[]
  conversations   Conversation[]
  sessions        GuideSession[]
  answers         GuideAnswer[]
  rewards         GuideRewardEntry[]

  @@index([institutionId, state])
  @@index([state, evidenceExpiresAt])
  @@map("student_guides")
}

/// Evidence for one verification step (Phase 3 §1).
///
/// Stored separately from the guide record and never exposed publicly, exactly
/// as institution evidence is in Phase 1 §2. `evidenceRef` is an object key or a
/// challenge id — the document itself never enters the database.
model GuideVerification {
  id                 String            @id @default(uuid())
  guideId            String
  evidenceType       GuideEvidenceType
  evidenceRef        String?
  /// Short, internal description of what was checked.
  summary            String
  verifiedAt         DateTime?
  expiresAt          DateTime?
  reviewerId         String?
  /// Single-use token hash for the university-domain email challenge. The token
  /// itself is never stored, and never written to a log.
  challengeTokenHash String?
  challengeExpiresAt DateTime?
  createdAt          DateTime          @default(now())

  guide StudentGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, evidenceType])
  @@index([expiresAt])
  @@map("guide_verifications")
}

/// Identity drift (TRD §14): a guide who keeps changing which university or
/// programme they study is forced back through verification.
model GuideIdentityChange {
  id            String   @id @default(uuid())
  guideId       String
  field         String
  previousValue String?
  newValue      String?
  changedAt     DateTime @default(now())

  guide StudentGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, changedAt])
  @@map("guide_identity_changes")
}

/// Availability with topics and hours (Phase 3 §2).
///
/// `booked` is incremented inside the booking transaction under a row lock, so
/// two students clicking the same slot cannot both get it. The platform prevents
/// overbooking; the guide is not asked to notice it.
model GuideAvailabilitySlot {
  id       String       @id @default(uuid())
  guideId  String
  startsAt DateTime
  endsAt   DateTime
  topics   GuideTopic[]
  capacity Int          @default(1)
  booked   Int          @default(0)

  createdAt DateTime @default(now())

  guide    StudentGuide   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  sessions GuideSession[]

  @@index([guideId, startsAt])
  @@map("guide_availability_slots")
}

enum ConversationContextType {
  institution
  program
  application
  general
}

enum ConversationStatus {
  open
  closed
  suspended
  archived
}

/// A conversation between one student and one guide (Phase 3 §3, FR-008).
///
/// Scoped to a context wherever possible — an institution, a programme, later an
/// application — because "which university are we talking about?" is the first
/// thing both a moderator and a returning student need to know.
model Conversation {
  id          String                  @id @default(uuid())
  studentId   String
  guideId     String
  contextType ConversationContextType @default(general)
  contextId   String?
  status      ConversationStatus      @default(open)

  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  closedAt      DateTime?
  closedReason  String?

  student  User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guide    StudentGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([studentId, guideId, contextType, contextId])
  @@index([studentId, lastMessageAt])
  @@index([guideId, lastMessageAt])
  @@map("conversations")
}

enum MessageSenderRole {
  student
  guide
  system
}

enum MessageKind {
  text
  attachment
  system
}

enum MessageModerationState {
  clean
  flagged
  withheld
  under_review
}

enum SystemMessageKind {
  conversation_opened
  guide_restricted
  guide_suspended
  conversation_closed
  risk_flagged
  session_booked
  session_cancelled
  report_submitted
}

model Message {
  id              String                 @id @default(uuid())
  conversationId  String
  /// Null for a system message; there is no user behind one.
  senderId        String?
  senderRole      MessageSenderRole
  kind            MessageKind            @default(text)
  systemKind      SystemMessageKind?
  body            String
  /// A `DocumentVersion` id. The vault's scan rules still decide whether it can
  /// be opened; sharing a file in a chat does not launder it.
  attachmentRef   String?
  moderationState MessageModerationState @default(clean)
  /// Why it was flagged, shown above the message. The body is never edited.
  flagSummary     String?

  sentAt DateTime  @default(now())
  readAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

enum RiskSignal {
  payment_solicitation
  guarantee_claim
  off_platform_solicitation
  identity_drift
  message_spam
  impersonation
}

enum RiskSeverity {
  low
  medium
  high
  critical
}

/// **Evidence, preserved before any moderation action** (Phase 3 §4).
///
/// `bodySnapshot` is the message exactly as it was sent, copied here at flag
/// time. The message row is never edited — but a row that can be edited is not
/// evidence, so the copy lives in a table the application has no update or
/// delete path to, and the migration installs the same append-only trigger the
/// audit log uses.
///
/// `messageId` and `trustCaseId` are plain columns rather than foreign keys, and
/// that is deliberate: **evidence outlives the thing it is evidence of.** A
/// message row removed under a data-erasure request, or a case deleted in some
/// future cleanup, must not be able to take the record of a payment demand with
/// it — and a foreign key would do exactly that, since a cascade or a restrict
/// both make the evidence a hostage of the row it describes.
model MessageFlag {
  id           String       @id @default(uuid())
  messageId    String
  signal       RiskSignal
  severity     RiskSeverity
  /// The exact substrings that matched. Short, and quoted from the message.
  matches      String[]
  bodySnapshot String
  /// SHA-256 of the snapshot, so tampering at the storage layer is detectable.
  bodyHash     String
  trustCaseId  String?
  createdAt    DateTime     @default(now())

  @@index([messageId])
  @@index([trustCaseId])
  @@index([signal, severity])
  @@map("message_flags")
}

enum TrustCaseType {
  payment_solicitation
  guarantee_claim
  off_platform_contact
  impersonation
  identity_drift
  spam
  harassment
  fraudulent_offer
  false_institution_claim
  other
}

enum TrustCaseState {
  open
  triaging
  evidence_preserved
  actioned
  dismissed
  escalated
}

enum ReportableTargetType {
  guide
  message
  conversation
  offer
  institution
  program
  user
}

/// Any user can report any person, offer, institutional claim or message
/// (FR-015). The case is the auditable record of that report.
model TrustCase {
  id            String               @id @default(uuid())
  type          TrustCaseType
  /// Null when the platform opened the case itself, from a risk rule.
  reporterId    String?
  targetType    ReportableTargetType
  targetId      String
  state         TrustCaseState       @default(open)
  severity      RiskSeverity         @default(medium)
  summary       String
  /// What the reporter saw, in their words.
  description   String?
  assignedTo    String?
  correlationId String

  openedAt DateTime  @default(now())
  closedAt DateTime?

  events TrustCaseEvent[]

  @@index([state, severity])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("trust_cases")
}

model TrustCaseEvent {
  id        String          @id @default(uuid())
  caseId    String
  fromState TrustCaseState?
  toState   TrustCaseState
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())

  trustCase TrustCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("trust_case_events")
}

enum SessionChannel {
  chat
  audio
  video
}

enum SessionStatus {
  requested
  confirmed
  completed
  cancelled
  no_show
}

enum RewardState {
  not_earned
  earned
  approved
  paid
  withheld
}

enum RewardKind {
  fixed_stipend
  platform_credit
  scholarship_contribution
  certificate
  university_supported
}

/// A scheduled session (Phase 3 §3).
///
/// Note what this table does **not** have: an amount, a payee, or a payment
/// reference. There is no direct payment path to a guide, and the schema is
/// where that is true rather than the terms of service.
model GuideSession {
  id        String  @id @default(uuid())
  studentId String
  guideId   String
  slotId    String?

  channel         SessionChannel @default(chat)
  scheduledFor    DateTime
  durationMinutes Int            @default(30)
  status          SessionStatus  @default(requested)
  topics          GuideTopic[]
  /// Modex-managed joining detail. A room reference, never a phone number.
  joinRef         String?

  /// Depends on session delivery and nothing else — never on an application
  /// outcome (Phase 3 §5). There is deliberately no application column on this
  /// table to join against.
  rewardState RewardState @default(not_earned)

  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  disputedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guide   StudentGuide           @relation(fields: [guideId], references: [id], onDelete: Cascade)
  slot    GuideAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  rewards GuideRewardEntry[]

  @@index([studentId, scheduledFor])
  @@index([guideId, scheduledFor])
  @@index([status])
  @@map("guide_sessions")
}

/// The reward ledger (Phase 3 §5). Payouts run through the Modex-controlled
/// workflow; the finance surface in #8 approves and pays them.
model GuideRewardEntry {
  id          String      @id @default(uuid())
  guideId     String
  sessionId   String?
  kind        RewardKind  @default(fixed_stipend)
  state       RewardState @default(earned)
  /// Integer minor units + ISO 4217, like every other money column here. Null
  /// for a certificate, which is a reward with no amount.
  amountMinor Int?
  currency    String?     @db.Char(3)
  earnedAt    DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  note        String?

  createdAt DateTime @default(now())

  guide   StudentGuide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  session GuideSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  payouts Payout[]

  @@index([guideId, state])
  @@map("guide_reward_entries")
}

enum QaState {
  draft
  pending_moderation
  published
  rejected
  withdrawn
}

/// A public question. `askedById` is cleared when the answer is published: the
/// question becomes public, the student who asked it does not.
model GuideQuestion {
  id            String     @id @default(uuid())
  askedById     String?
  institutionId String
  programKey    String?
  topic         GuideTopic
  body          String
  createdAt     DateTime   @default(now())

  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  answers     GuideAnswer[]

  @@index([institutionId, topic])
  @@map("guide_questions")
}

/// An answer needs **two** independent yeses to be published — a moderator's
/// and the guide's own (Phase 3 §3). Neither column can be inferred from the
/// other, and `canPublishAnswer` in the contracts package requires both.
model GuideAnswer {
  id         String  @id @default(uuid())
  questionId String
  guideId    String
  body       String
  state      QaState @default(draft)

  moderatedAt      DateTime?
  moderatedBy      String?
  moderationNote   String?
  guideConsentedAt DateTime?
  publishedAt      DateTime?
  helpfulCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question GuideQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  guide    StudentGuide  @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([state, publishedAt])
  @@map("guide_answers")
}

// ---------------------------------------------------------------------------
// Applications, snapshots and connectors (Phase 4 §1–§3)
// ---------------------------------------------------------------------------

enum ApplicationState {
  draft
  ready
  submitted_pending
  submitted
  failed
  under_review
  more_info
  offer
  accepted
  declined
  rejected
  withdrawn
  expired
  enrolled
}

enum ConnectorType {
  api
  portal_handoff
  deep_link
  file_exchange
  operator_assisted
}

enum ApplicationOwner {
  student
  university
  modex_ops
}

enum ApplicationTaskType {
  complete_profile_field
  upload_document
  replace_document
  accept_consent
  answer_question
  pay_application_fee
  university_review
  provide_more_info
  operator_submission
}

enum ApplicationTaskStatus {
  open
  blocked
  done
  cancelled
}

enum SubmissionAttemptState {
  in_flight
  accepted
  awaiting_handoff
  queued
  rejected
  failed
  dead_lettered
}

enum InboundStatusKind {
  received
  under_review
  more_info_required
  offer_made
  rejected
  withdrawn
  enrolled
}

/// One application, for one student, against one intake.
///
/// `programKey` rather than `programId`: an application follows the programme
/// across effective-dated versions, and the exact version it was *submitted*
/// against lives on the snapshot, which is the only place a version needs to be
/// pinned. Pinning it here as well would mean an editorial change to the
/// description silently orphaned a draft.
model Application {
  id            String           @id @default(uuid())
  studentId     String
  institutionId String
  programKey    String
  intakeId      String
  state         ApplicationState @default(draft)
  /// Which route this application takes. Read from the partner's connector
  /// configuration at creation and frozen, because changing it mid-flight would
  /// mean a payload built for one protocol delivered over another.
  connectorId   String?
  connectorType ConnectorType?
  /// Who the application is waiting on. Drives both checklists from one column.
  currentOwner  ApplicationOwner @default(student)

  /// The university's own reference, once they have given one. Until this is
  /// non-null the application cannot be in `submitted` — enforced in
  /// `ApplicationsService`, and the reason `submitted_pending` exists.
  externalRef String?
  submittedAt DateTime?
  confirmedAt DateTime?

  /// The requirement ids and versions the student was shown when they marked
  /// the application ready. Re-validation at submission compares against this;
  /// a timestamp would only answer "did anything get written?".
  acknowledgedRequirements Json      @default("[]")
  /// Set when a Modex operator submitted on the student's behalf. Non-null is
  /// what makes `<DisclosureNotice>` permanent on the application.
  operatorSubmittedById    String?
  operatorSubmittedAt      DateTime?

  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student        User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution    Institution              @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  intake         Intake                   @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  connector      ConnectorConfig?         @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  tasks          ApplicationTask[]
  attempts       SubmissionAttempt[]
  events         ApplicationStatusEvent[]
  offers         ApplicationOffer[]
  admissionOffer AdmissionOffer?

  /// One application per student per intake, enforced in the database rather
  /// than in a service check that two concurrent requests can both pass.
  ///
  /// The issue allows duplicates "where partner rules allow". That escape hatch
  /// is not built: it needs a per-partner policy and a rule for which of the
  /// duplicates a status event belongs to, and guessing at either now would be
  /// guessing. A different intake of the same programme is a different row and
  /// is allowed today.
  @@unique([studentId, intakeId])
  @@index([studentId, state])
  @@index([institutionId, state])
  @@index([externalRef])
  @@map("applications")
}

/// Drives the student's checklist and the university's queue from one table,
/// because "who is this waiting on?" has to have exactly one answer.
model ApplicationTask {
  id            String                @id @default(uuid())
  applicationId String
  owner         ApplicationOwner
  type          ApplicationTaskType
  title         String
  /// What to do about it, in the student's words. A task with no remedy is a nag.
  detail        String?
  dueAt         DateTime?
  status        ApplicationTaskStatus @default(open)
  createdAt     DateTime              @default(now())
  completedAt   DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@index([owner, status, dueAt])
  @@map("application_tasks")
}

/// **Append-only. There is no edit path, for any role** (Phase 4 §2, FR-011).
///
/// The migration installs the same trigger `audit_events` and `message_flags`
/// carry. A snapshot that can be edited by the process acting on it is not a
/// record of what was sent, it is a record of what someone later wished had
/// been sent.
///
/// **No foreign keys at all**, and for a reason that had to be measured rather
/// than assumed: a referential `ON DELETE CASCADE` runs a real DELETE against
/// the child table and *does* fire its row triggers. An `applicationId`
/// foreign key would therefore have made `DELETE FROM applications` fail
/// outright, and `TRUNCATE ... CASCADE` with it — the append-only guarantee
/// quietly turning into "an application can never be removed". `message_flags`
/// avoids the same trap for the same reason, one phase earlier.
///
/// So the columns below are plain references. `documentVersionIds` are exact
/// `DocumentVersion` ids and the payload carries their checksums, so a student
/// uploading a better scan tomorrow changes nothing here; a version removed
/// under a retention sweep does not take the evidence of what was submitted
/// with it either.
model ApplicationSnapshot {
  id                 String   @id @default(uuid())
  applicationId      String
  /// Which *submission* this snapshot froze — not which network call.
  ///
  /// The distinction is load-bearing. Retrying a timeout re-sends these exact
  /// bytes under the same partner key, so it shares this snapshot; resubmitting
  /// after a rejection builds a new payload, so it gets the next number. One
  /// snapshot can therefore back several `SubmissionAttempt` rows, and that is
  /// what makes "the payload is reproducible" true across a retry storm.
  submissionNo       Int
  /// Content hash of the profile data that went into the payload.
  profileVersion     String
  documentVersionIds String[]
  /// The payload exactly as serialised. Canonical JSON, so the bytes are a
  /// function of the values rather than of key insertion order.
  payload            Json
  /// SHA-256 over the canonical form of `payload`.
  payloadHash        String
  createdAt          DateTime @default(now())

  @@unique([applicationId, submissionNo])
  @@index([payloadHash])
  @@map("application_snapshots")
}

/// One partner's connector configuration. The adapter boundary is what keeps
/// university-specific logic out of the core: this row is the configuration,
/// and `ConnectorRegistry` picks the adapter for `type`.
model ConnectorConfig {
  id                  String        @id @default(uuid())
  institutionId       String
  type                ConnectorType
  displayName         String
  /// Where the payload goes. Null for `operator_assisted`, which has no endpoint.
  endpointUrl         String?
  /// Reference to the credential in the secret store. **Never the secret.**
  credentialRef       String?
  /// Reference to the webhook signing secret, likewise by name only.
  signingSecretRef    String?
  /// Per-partner poll budget for connectors with no webhooks. A university that
  /// asks for one call a minute gets one call a minute.
  pollIntervalSeconds Int           @default(900)
  /// Flag gating rollout. Every connector ships behind one, per partner.
  featureFlag         String        @default("connector.direct_application")
  enabled             Boolean       @default(false)
  /// Free-form partner settings the adapter understands. No core branch reads it.
  settings            Json          @default("{}")
  lastPolledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applications Application[]
  events       ApplicationStatusEvent[]

  @@unique([institutionId, type])
  @@index([enabled])
  @@map("connector_configs")
}

/// Every attempt to hand a payload to a university, successful or not.
///
/// The idempotency key is stored here as well as in `idempotency_records`, and
/// the two answer different questions: the platform record stops a duplicate
/// *request*, and this column is what is sent to the partner so a retry cannot
/// create a duplicate *application at the university*.
model SubmissionAttempt {
  id             String                 @id @default(uuid())
  applicationId  String
  connectorId    String?
  /// The snapshot whose bytes this call sent. Every attempt has one. A plain
  /// reference rather than a foreign key, for the same reason as above: a
  /// constraint pointing at an append-only table is a constraint that can
  /// block deleting the parent.
  snapshotId     String
  /// Sequential network call against this application, retries included.
  attemptNo      Int
  state          SubmissionAttemptState @default(in_flight)
  /// **The partner-facing key**, and deliberately not unique here.
  ///
  /// It is derived from the snapshot, so every retry of one submission carries
  /// the same value and the university's own duplicate guard sees one
  /// application. The *platform's* duplicate guard is a different mechanism
  /// living in `idempotency_records`, keyed on the client's request header;
  /// collapsing the two would mean a client that retried with a fresh header
  /// created a second application at the university.
  idempotencyKey String
  /// Set only by an `accepted` outcome carrying a non-empty reference.
  externalRef    String?
  /// Whatever the partner returned, verbatim. The receipt, kept as evidence.
  responseBody   Json                   @default("{}")
  failureCode    String?
  failureReason  String?
  /// The trace from click to external call lives on this column.
  correlationId  String
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?
  nextRetryAt    DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, attemptNo])
  @@index([snapshotId])
  @@index([idempotencyKey])
  @@index([state, nextRetryAt])
  @@index([correlationId])
  @@map("submission_attempts")
}

/// Inbound status from a university. **Every event is kept**, including ones
/// that changed nothing: the TRD's "keep all inbound status events" is what
/// makes a disputed decision reconstructable.
model ApplicationStatusEvent {
  id              String            @id @default(uuid())
  applicationId   String?
  connectorId     String?
  /// The partner's own event id — the idempotency key for inbound traffic.
  providerEventId String
  externalRef     String
  kind            InboundStatusKind
  occurredAt      DateTime
  receivedAt      DateTime          @default(now())
  /// Partner detail, stored verbatim and never interpreted.
  detail          Json              @default("{}")
  /// False when the event was valid but changed no state — a duplicate status,
  /// or one arriving out of order. Kept anyway.
  applied         Boolean           @default(false)
  /// Why it was not applied, when it was not.
  skippedReason   String?
  correlationId   String

  application Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  connector   ConnectorConfig? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  /// Replay safety, as a constraint rather than as a check in application code.
  @@unique([connectorId, providerEventId])
  @@index([applicationId, occurredAt])
  @@index([externalRef])
  @@map("application_status_events")
}

// ---------------------------------------------------------------------------
// Offers, scholarships, discounts and fee waivers (Phase 5, FR-013 / FR-014)
// ---------------------------------------------------------------------------
//
// Two structural decisions, both load-bearing:
//
//  1. **`Offer` is effective-dated, exactly like `Program`.** Editing a live
//     offer closes the current row and writes the next version. An application
//     that referenced version 2 keeps pointing at version 2, so a partner
//     halving an award in June cannot retroactively change what a student was
//     shown — and accepted — in March.
//
//  2. **Value is never a string.** A percentage is integer basis points, a cash
//     award is integer minor units plus ISO 4217, and a benefit carries a named
//     benefit and provider with no monetary value at all. There is nowhere in
//     this schema to write "up to £5,000 off".

enum OfferType {
  scholarship
  tuition_discount
  application_fee_waiver
  deposit_incentive
  student_benefit
}

enum OfferValueKind {
  percentage
  fixed_amount
  full_waiver
  benefit_in_kind
}

/// Which cost line the offer reduces. `none` is a benefit in kind, which
/// reduces nothing and is deliberately kept out of every net-price calculation.
enum OfferBase {
  tuition
  application_fee
  deposit
  none
}

enum OfferDuration {
  one_off
  first_year
  every_year
}

enum OfferPublicationState {
  draft
  in_review
  published
  unpublished
  expired
}

enum OfferExclusionKind {
  not_combinable_with_offer
  not_combinable_with_type
  first_year_only
  new_students_only
  requires_full_upfront_payment
  excludes_programmes
}

enum OfferAttachmentState {
  attached
  accepted
  declined
  expired
  realised
  superseded
}

enum AdmissionOfferKind {
  conditional
  unconditional
}

model Offer {
  id            String  @id @default(uuid())
  /// Stable across every effective-dated version of the same offer.
  offerKey      String
  institutionId String
  /// Null means institution-wide: every published programme, minus exclusions.
  programKey    String?

  type        OfferType
  name        String
  /// Value, as a discriminated set of columns rather than free JSON, so the
  /// database refuses a percentage with no percentage and a cash award with no
  /// currency (see the CHECK constraint in the migration).
  valueKind   OfferValueKind
  /// 1 = 0.01%. A 12.5% discount is 1250.
  basisPoints Int?
  amountMinor Int?
  currency    String?        @db.Char(3)
  benefit     String?
  provider    String?

  appliesTo OfferBase
  duration  OfferDuration @default(first_year)

  /// The same shape `Requirement.ruleJson` carries, as an array — the offer
  /// conditions run through the *programme* eligibility engine. One engine.
  conditions Json @default("[]")

  /// Plain-language conditions. Never a substitute for `exclusions`, which are
  /// their own rows precisely so stacking can be computed rather than read.
  termsSummary      String?
  /// How a student claims it. Mandatory for a scholarship.
  applicationMethod String?
  /// How a benefit is redeemed. Mandatory for a student benefit.
  redemptionMethod  String?
  /// The award's own deadline, which is not the intake deadline.
  claimDeadline     DateTime?

  validFrom  DateTime
  validUntil DateTime

  publicationState  OfferPublicationState @default(draft)
  unpublishedAt     DateTime?
  unpublishedReason String?

  /// Verification (Phase 0 §2.9). `verifiedBy` and `lastCheckedAt` are what the
  /// card requires before it will render at all.
  verificationState VerificationState @default(unverified)
  verifiedBy        String?
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?

  // Provenance, on this record as on every catalogue record.
  sourceUpdatedAt DateTime?
  expiresAt       DateTime?
  syncState       SyncState @default(pending_review)
  sourceRef       String?
  reviewedBy      String?
  staleFields     String[]

  version       Int       @default(1)
  effectiveFrom DateTime  @default(now())
  /// Null means "current". A closed version is immutable history.
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  exclusions   OfferExclusion[]
  sourceChecks OfferSourceCheck[]
  attachments  ApplicationOffer[]

  @@unique([offerKey, version])
  @@index([institutionId, publicationState])
  @@index([offerKey, effectiveTo])
  @@index([programKey, publicationState])
  /// The auto-expiry sweep's query: live offers whose window has closed.
  @@index([publicationState, validUntil])
  @@map("offers")
}

/// An exclusion is a row, not a sentence in the terms.
///
/// "Not combinable with the country award" has to be *computed* — the stacking
/// resolver reads these and produces a stated reason for every offer it did not
/// apply — and a human-readable summary is mandatory because an exclusion
/// nobody can read is one that gets discovered at the worst possible moment.
model OfferExclusion {
  id             String             @id @default(uuid())
  offerId        String
  kind           OfferExclusionKind
  /// The other offer, for `not_combinable_with_offer`.
  otherOfferKey  String?
  /// The other category, for `not_combinable_with_type`.
  otherOfferType OfferType?
  /// Programme keys carved out, for `excludes_programmes`.
  programKeys    String[]
  humanSummary   String

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_exclusions")
}

/// One re-check of an offer against its source (TRD §6, §14).
///
/// Every row is a dated answer to "is this still what the university says?". A
/// mismatch is a **trust incident**, not a data bug: the offer is unpublished,
/// a trust case is opened, and the partner is notified — and this table is the
/// evidence that sequence happened.
model OfferSourceCheck {
  id          String   @id @default(uuid())
  offerId     String
  checkedAt   DateTime @default(now())
  checkedBy   String?
  sourceRef   String
  matched     Boolean
  /// What the source said, when it differed. Stored verbatim, never parsed into
  /// the offer — a mismatch is escalated, never auto-applied.
  observed    Json     @default("{}")
  note        String?
  /// The case this mismatch opened, when it opened one.
  trustCaseId String?

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, checkedAt])
  @@index([matched])
  @@map("offer_source_checks")
}

/// An offer attached to an application.
///
/// `offerId` pins the *version*, and the value columns are frozen copies taken
/// at attachment. Both, not either: the pin is what makes the reference stable,
/// and the frozen value is what makes a receipt reproducible even if the offer
/// row is later removed under a retention sweep.
model ApplicationOffer {
  id            String               @id @default(uuid())
  applicationId String
  offerId       String
  /// Denormalised so the "did this student ever hold this award?" question does
  /// not have to walk every version of it.
  offerKey      String
  state         OfferAttachmentState @default(attached)

  valueKind   OfferValueKind
  basisPoints Int?
  amountMinor Int?
  currency    String?        @db.Char(3)
  /// What the offer was worth against this application's own costs when it was
  /// attached, in minor units. This is the figure the savings metric counts.
  savingMinor Int?

  attachedAt  DateTime  @default(now())
  respondedAt DateTime?
  expiredAt   DateTime?
  /// Set at enrolment, and only then. "Savings secured" counts this column.
  realisedAt  DateTime?
  note        String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)

  /// One live attachment per offer per application. A student cannot hold the
  /// same award twice, and two concurrent requests cannot both create it.
  @@unique([applicationId, offerKey])
  @@index([applicationId, state])
  @@index([offerId])
  @@map("application_offers")
}

/// The **admission** offer: the university's decision on the application.
///
/// Its own table, with its own vocabulary, because the single most damaging
/// thing this phase could do is let "you have an offer" mean a discount on a
/// search card and an admission decision on a dashboard. Nothing joins this to
/// `offers`, and no component takes both.
model AdmissionOffer {
  id            String             @id @default(uuid())
  applicationId String             @unique
  kind          AdmissionOfferKind
  /// `[{ summary, met, evidence }]` — the university's conditions, as they
  /// wrote them.
  conditions    Json               @default("[]")
  issuedAt      DateTime
  /// The university's own deadline for a reply.
  respondByAt   DateTime?
  /// The university's reference for this decision.
  externalRef   String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([respondByAt])
  @@map("admission_offers")
}

// ---------------------------------------------------------------------------
// Phase 6 — the admin consoles (#8)
// ---------------------------------------------------------------------------

enum SanctionKind {
  warn
  restrict
  suspend
  ban
}

enum SanctionTargetType {
  guide
  user
  offer
  institution
}

enum SanctionReasonCode {
  payment_solicitation
  guarantee_claim
  impersonation
  off_platform_contact
  spam
  harassment
  identity_unverified
  identity_drift
  fraudulent_offer
  false_institution_claim
  repeat_violation
  other
}

/// A sanction issued from the trust console.
///
/// `targetId` is a plain column rather than a foreign key, for the same reason
/// `MessageFlag` uses one: the record of a ban must outlive the row it was
/// issued against, and a cascade would let an erasure request quietly delete
/// the history of why somebody was removed.
///
/// Reversal is a write to `reversedAt`, never a delete. Both the sanction and
/// its reversal produce audit events, so "was this person ever banned" stays
/// answerable after the ban is lifted.
model Sanction {
  id            String             @id @default(uuid())
  targetType    SanctionTargetType
  targetId      String
  kind          SanctionKind
  reasonCode    SanctionReasonCode
  /// The sentence a human wrote. The code is for counting; this is for appeals.
  reason        String
  /// The trust case this came out of, when there is one.
  caseId        String?
  actorId       String
  correlationId String
  appliedAt     DateTime           @default(now())
  /// Null is permanent. Only `warn` and `restrict` are expected to carry one.
  expiresAt     DateTime?

  reversedAt     DateTime?
  reversedBy     String?
  reversalReason String?

  @@index([targetType, targetId])
  @@index([kind, appliedAt])
  @@index([caseId])
  @@map("sanctions")
}

/// Support impersonation (Phase 6 §3): controlled, time-boxed, consented, and
/// always audited.
///
/// The subject can read their own grants — that is what makes "the student sees
/// that it happened" true in the data rather than in a policy document.
model ImpersonationGrant {
  id            String    @id @default(uuid())
  operatorId    String
  subjectId     String
  /// Why, in the operator's words. Copied verbatim into the audit event.
  reason        String
  /// The support ticket or trust case this is being done for.
  reference     String
  correlationId String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  /// Set when the operator ends it early, or when the sweeper closes an expired
  /// one. An open grant past `expiresAt` grants nothing either way.
  endedAt       DateTime?
  endedReason   String?

  @@index([subjectId, startedAt])
  @@index([operatorId, startedAt])
  @@index([expiresAt])
  @@map("impersonation_grants")
}

enum RequirementDecision {
  approved
  overridden
  annotated
}

/// A university's review of a machine rule the eligibility engine produced.
///
/// Every row carries before and after values: an override with no `before` is
/// an assertion, and an assertion cannot be audited. The prior requirement
/// version is copied in rather than referenced, because requirements are
/// effective-dated and the row this review looked at will be superseded.
///
/// `requirementId` is a plain column rather than a foreign key, for the same
/// reason `MessageFlag` uses one: **the record of a decision outlives the row it
/// was made about.** A requirement superseded, or a programme withdrawn, must
/// not be able to take the record of who overrode what with it — and a foreign
/// key would do exactly that, since a cascade deletes the evidence and a
/// restrict makes the append-only table impossible to clean up around.
model RequirementReview {
  id                 String              @id @default(uuid())
  requirementId      String
  institutionId      String
  decision           RequirementDecision
  reason             String
  beforeRuleJson     Json
  beforeHumanSummary String
  afterRuleJson      Json?
  afterHumanSummary  String?
  actorId            String
  correlationId      String
  createdAt          DateTime            @default(now())

  @@index([requirementId, createdAt])
  @@index([institutionId, createdAt])
  @@map("requirement_reviews")
}

enum NotificationChannel {
  email
  sms
  in_app
}

enum NotificationDeliveryState {
  queued
  sent
  delivered
  bounced
  failed
  suppressed
}

/// Operator-editable message templates.
///
/// Editing one is versioned rather than overwritten: a student who asks "what
/// did that email say" months later is asking about the version they received,
/// not the one being sent today.
model NotificationTemplate {
  id        String              @id @default(uuid())
  key       String
  channel   NotificationChannel
  locale    String              @default("en")
  subject   String?
  body      String
  version   Int                 @default(1)
  active    Boolean             @default(true)
  updatedBy String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  deliveries NotificationDelivery[]

  @@unique([key, channel, locale, version])
  @@index([key, active])
  @@map("notification_templates")
}

model NotificationDelivery {
  id            String                    @id @default(uuid())
  templateId    String?
  templateKey   String
  channel       NotificationChannel
  /// Who it went to, by id. Never the address itself — an address in a
  /// monitoring table is PII sitting somewhere nobody thinks of as a store.
  recipientId   String
  state         NotificationDeliveryState @default(queued)
  failureReason String?
  correlationId String
  queuedAt      DateTime                  @default(now())
  sentAt        DateTime?
  settledAt     DateTime?

  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([templateKey, state])
  @@index([recipientId, queuedAt])
  @@map("notification_deliveries")
}

enum TransactionKind {
  service_payment
  service_refund
  guide_payout
}

enum TransactionState {
  pending
  settled
  failed
  reversed
}

/// Modex's own money only (TRD §15).
///
/// Tuition is never collected here. A tuition payment appears, if at all, as a
/// reference a student recorded — and there is deliberately no column on this
/// table it could be written into.
model ModexTransaction {
  id            String           @id @default(uuid())
  kind          TransactionKind
  state         TransactionState @default(pending)
  amountMinor   Int
  currency      String           @db.Char(3)
  /// The payment processor's reference. Not a card, not an account number.
  externalRef   String?
  /// Who the money moved for. A student for a service payment, a guide for a payout.
  subjectUserId String?
  description   String
  correlationId String
  createdAt     DateTime         @default(now())
  settledAt     DateTime?

  refunds Refund[]
  payout  Payout?

  @@index([kind, state])
  @@index([subjectUserId, createdAt])
  @@map("modex_transactions")
}

enum RefundReasonCode {
  duplicate_charge
  service_not_delivered
  student_withdrew
  pricing_error
  goodwill
  chargeback
}

/// Refunds run against a Modex service payment and nothing else. The foreign
/// key is what enforces it: there is no row here that can point at tuition.
model Refund {
  id            String           @id @default(uuid())
  transactionId String
  amountMinor   Int
  currency      String           @db.Char(3)
  reasonCode    RefundReasonCode
  reason        String
  actorId       String
  correlationId String
  createdAt     DateTime         @default(now())

  transaction ModexTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@map("refunds")
}

enum PayoutState {
  pending_approval
  approved
  rejected
  paid
}

/// A guide payout, with the two-actor rule in the columns.
///
/// `initiatedBy` and `approvedBy` are separate columns so the constraint is
/// checkable after the fact, by anyone reading the table, without replaying the
/// application's logic. `GuideRewardEntry` is the ledger; this is the movement.
///
/// Note what is still absent: no application id, no admission outcome, nothing
/// to join a payment to whether the student got in (Phase 3 §5).
model Payout {
  id            String      @id @default(uuid())
  rewardEntryId String      @unique
  guideId       String
  amountMinor   Int
  currency      String      @db.Char(3)
  state         PayoutState @default(pending_approval)
  initiatedBy   String
  initiatedAt   DateTime    @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  rejectedBy    String?
  rejectedAt    DateTime?
  decisionNote  String?
  paidAt        DateTime?
  transactionId String?     @unique
  correlationId String

  rewardEntry GuideRewardEntry  @relation(fields: [rewardEntryId], references: [id], onDelete: Restrict)
  transaction ModexTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([state, initiatedAt])
  @@index([guideId])
  @@map("payouts")
}
