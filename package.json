{
  "name": "modex-apply",
  "version": "0.1.0",
  "private": true,
  "description": "Modex Apply \u2014 apply directly to verified universities, with help from students who already study there.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contrast": "node scripts/check-contrast.mjs",
    "check:vendor-hex": "node scripts/check-vendor-hex.mjs",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contrast && pnpm check:vendor-hex && pnpm check:migrations && pnpm check:secrets"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
